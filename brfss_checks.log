. 
. foreach run of global runs {
  2. 
.     use "$brfss", clear
  3. 
.     rename yq yq_date
  4.     assert inrange(yq_date, tq(2021q1), tq(2025q4))
  5.     quietly summarize _bmi5
  6.     assert r(mean) > 1500 & r(mean) < 5000
  7.     gen double bmi = _bmi5 / 100
  8. 
.     foreach v in ln_unwind $enrvar $pol_all {
  9.         capture confirm variable `v'
 10.         if _rc == 0 {
 11.             di as error "`v' already exists in the BRFSS file; rename it before merging"
 12.             exit 110
 13.         }
 14.     }
 15.     merge m:1 _state yq_date using "$ctrl/state_controls_yq.dta", keepusing(ln_unwind $enrvar $pol_all) keep(master match) generate(_ms)
 16.     drop _ms
 17. 
.     *---- stage flags (cumulative) ------------------------------------------------------------------
.     local last = cond("`run'" == "main", tq(2024q4), tq(2025q4))
 18.     gen long _s0 = 1
 19.     gen long _s1 = (diabetes != 1)
 20.     gen long _s2 = (_s1 == 1) & !(`drops')
 21.     if "`run'" == "ext" {
 22.         replace _s2 = 0 if inlist(_state, 6, 32, 28)
 23.     }
 24.     gen long _s3 = (_s2 == 1) & (yq_date <= `last')
 25.     gen long _s4 = (_s3 == 1) & (medicaid == 1)
 26.     egen byte _nmI = rowmiss(bmi $controls _llcpwt)
 27.     gen long _s5 = (_s4 == 1) & (_nmI == 0)
 28.     egen byte _nmS = rowmiss(${cs_S4})
 29.     gen long _s6 = (_s5 == 1) & (_nmS == 0)
 30. 
.     * the primary S1 rule in 03 (fixsample = 1): outcome + weight + individual controls + all S4 controls observed, Medicaid enrollees
.     egen byte _nmP = rowmiss(bmi $controls _llcpwt ${cs_S4})
 31.     quietly count if _s3 == 1 & medicaid == 1 & _nmP == 0
 32.     local nP = r(N)
 33.     quietly count if _s6 == 1
 34.     local n6 = r(N)
 35.     di as text _n "===================== `run' sample ====================="
 36.     di as text "check: respondents in stage s6 = `n6'; respondents the primary S1 rule keeps = `nP'"
 37.     assert `n6' == `nP'
 38. 
.     di as text _n "Stages (cumulative):"
 39.     forvalues j = 0/6 {
 40.         di as text "  s`j'  `lab`j''"
 41.     }
 42. 
.     *---- by quarter ------------------------------------------------------------------------------------
.     preserve
 43.     forvalues j = 0/6 {
 44.         quietly egen long _tg`j' = tag(_state yq_date) if _s`j' == 1
 45.         quietly replace _tg`j' = 0 if missing(_tg`j')
 46.     }
 47.     collapse (sum) n_s0=_s0 n_s1=_s1 n_s2=_s2 n_s3=_s3 n_s4=_s4 n_s5=_s5 n_s6=_s6 ///
>         ns_s0=_tg0 ns_s1=_tg1 ns_s2=_tg2 ns_s3=_tg3 ns_s4=_tg4 ns_s5=_tg5 ns_s6=_tg6, by(yq_date)
 48.     format yq_date %tq
 49.     gen str6 quarter = string(yq_date, "%tq")
 50.     gen str5 run = "`run'"
 51.     order run yq_date quarter
 52.     di as text _n "Respondents remaining after each stage, by interview quarter (`run'):"
 53.     list yq_date n_s0 n_s1 n_s2 n_s3 n_s4 n_s5 n_s6, noobs sep(0)
 54.     di as text _n "States with at least one respondent after each stage, by interview quarter (`run'):"
 55.     list yq_date ns_s0 ns_s1 ns_s2 ns_s3 ns_s4 ns_s5 ns_s6, noobs sep(0)
 56.     di as text _n "2021Q1 at each stage (`run'):"
 57.     forvalues j = 0/6 {
 58.         quietly summarize n_s`j' if yq_date == tq(2021q1), meanonly
 59.         local r1 = r(sum)
 60.         quietly summarize ns_s`j' if yq_date == tq(2021q1), meanonly
 61.         local s1 = r(sum)
 62.         di as text "  s`j'  `lab`j'':  respondents `r1', states `s1'"
 63.     }
 64.     acc_append "`acc_q'"
 65.     restore
 66. 
.     *---- 2021Q1 by state -----------------------------------------------------------------------------------
.     quietly count if yq_date == tq(2021q1)
 67.     local nq1 = r(N)
 68.     if `nq1' == 0 {
 69.         di as error _n "There are NO 2021Q1 respondents in the `run' BRFSS file."
 70.     }
 71.     if `nq1' > 0 {
 72.         preserve
 73.         keep if yq_date == tq(2021q1)
 74.         collapse (sum) n_s0=_s0 n_s1=_s1 n_s2=_s2 n_s3=_s3 n_s4=_s4 n_s5=_s5 n_s6=_s6, by(_state)
 75.         gen str5 run = "`run'"
 76.         order run _state
 77.         di as text _n "2021Q1 respondents by state at each stage (`run'; states with no 2021Q1 respondents are not listed):"
 78.         list _state n_s0 n_s1 n_s2 n_s3 n_s4 n_s5 n_s6, noobs sep(0)
 79.         acc_append "`acc_s'"
 80.         restore
 81.     }
 82. 
.     *---- why respondents are lost at s5 and s6 ------------------------------------------------------------------
.     di as text _n "Respondents lost between s4 (Medicaid enrollees) and s5 (BMI, weight, individual controls observed), by variable:"
 83.     di as text %-16s "variable" %16s "2021Q1 missing" %10s "share" %20s "later qtrs missing" %10s "share"
 84.     quietly count if _s4 == 1 & yq_date == tq(2021q1)
 85.     local d1 = r(N)
 86.     quietly count if _s4 == 1 & yq_date > tq(2021q1)
 87.     local d2 = r(N)
 88.     di as text "  (Medicaid respondents: `d1' in 2021Q1, `d2' in later quarters)"
 89.     foreach v in bmi _llcpwt $controls {
 90.         quietly count if _s4 == 1 & yq_date == tq(2021q1) & missing(`v')
 91.         local m1 = r(N)
 92.         quietly count if _s4 == 1 & yq_date > tq(2021q1) & missing(`v')
 93.         local m2 = r(N)
 94.         local sh1 = cond(`d1' > 0, `m1' / `d1', .)
 95.         local sh2 = cond(`d2' > 0, `m2' / `d2', .)
 96.         di as text %-16s "`v'" %16.0fc `m1' %10.3f `sh1' %20.0fc `m2' %10.3f `sh2'
 97.     }
 98. 
.     di as text _n "Respondents lost between s5 and s6 (a state-level control is missing):"
 99.     quietly count if _s5 == 1 & yq_date == tq(2021q1)
100.     local a1 = r(N)
101.     quietly count if _s5 == 1 & _s6 == 0 & yq_date == tq(2021q1)
102.     local l1 = r(N)
103.     quietly count if _s5 == 1 & yq_date == tq(2021q1) & missing($enrvar)
104.     local enr1 = r(N)
105.     quietly count if _s5 == 1 & _s6 == 0 & yq_date == tq(2021q1) & !missing($enrvar)
106.     local oth1 = r(N)
107.     quietly count if _s5 == 1 & yq_date > tq(2021q1)
108.     local a2 = r(N)
109.     quietly count if _s5 == 1 & _s6 == 0 & yq_date > tq(2021q1)
110.     local l2 = r(N)
111.     di as text "  2021Q1:       s5 respondents `a1', lost at s6 `l1'  (missing enrollment control $enrvar: `enr1'; lost for another control: `oth1')"
112.     di as text "  later quarters: s5 respondents `a2', lost at s6 `l2'"
113.     di as text "  losses at s6 by state, all quarters (expected: the DC and Nebraska respondents):"
114.     capture noisily tab _state if _s5 == 1 & _s6 == 0
115.     di as text "  s5 respondents with each state-level control missing (2021Q1 | later quarters):"
116.     foreach v in ln_unwind $enrvar $pol_all {
117.         quietly count if _s5 == 1 & yq_date == tq(2021q1) & missing(`v')
118.         local m1 = r(N)
119.         quietly count if _s5 == 1 & yq_date > tq(2021q1) & missing(`v')
120.         local m2 = r(N)
121.         di as text "    " %-24s "`v'" %10.0fc `m1' %12.0fc `m2'
122.     }
123. 
.     *---- B. BMI < 30 and BMI >= 30 ---------------------------------------------------------------------------------
.     di as text _n "BMI by group (`run'): stages s6 (primary S1 sample), s5, s4. Weighted = BRFSS weight _llcpwt."
124.     foreach j in 6 5 4 {
125.         local n_all = .
126.         local sw_all = .
127.         foreach g in all lt30 ge30 {
128.             local cnd "_s`j' == 1 & !missing(bmi)"
129.             if "`g'" == "lt30" local cnd "`cnd' & bmi < 30"
130.             if "`g'" == "ge30" local cnd "`cnd' & bmi >= 30"
131.             quietly summarize bmi if `cnd'
132.             local n   = r(N)
133.             local mu  = r(mean)
134.             local sdu = r(sd)
135.             local mn  = r(min)
136.             local mx  = r(max)
137.             quietly summarize bmi [aw = _llcpwt] if `cnd'
138.             local nw  = r(N)
139.             local muw = r(mean)
140.             quietly summarize _llcpwt if `cnd', meanonly
141.             local sw  = r(sum)
142.             capture drop _dv
143.             quietly gen double _dv = (bmi - `muw')^2 * _llcpwt if `cnd'
144.             quietly summarize _dv, meanonly
145.             local sdw = sqrt(r(sum) / `sw')
146.             drop _dv
147.             capture drop _tgb
148.             quietly egen byte _tgb = tag(_state) if `cnd'
149.             quietly count if _tgb == 1
150.             local nst = r(N)
151.             drop _tgb
152.             if "`g'" == "all" {
153.                 local n_all  = `n'
154.                 local sw_all = `sw'
155.             }
156.             local shu = `n' / `n_all'
157.             local shw = `sw' / `sw_all'
158.             post hb ("`run'") ("s`j'") ("`g'") (`n') (`nst') (`mu') (`sdu') (`mn') (`mx') (`nw') (`muw') (`sdw') (`sw') (`shu') (`shw')
159.         }
160.     }
161. }
