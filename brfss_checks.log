. tempfile acc_q acc_s

. local drops "inlist(_state, 1, 12, 13, 20, 28, 37, 45, 46, 47, 48) | inlist(_state, 55, 56)"

. local lab0 "all records in the BRFSS analytic file"

. local lab1 "no diabetes (diabetes != 1)"

. local lab2 "analysis states (repo drops; ext also drops CA, NV)"

. local lab3 "analysis window (main: through 2024Q4)"

. local lab4 "Medicaid enrollees (medicaid == 1)"

. local lab5 "BMI, weight and individual controls observed"

. local lab6 "state-level controls observed = primary S1 sample"

