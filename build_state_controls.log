. 
. *---- 1. state-quarter file ----------------------------------------------------
. use "$prep/GLP1_state_quarter_analysis.dta", clear

. capture confirm variable yq

. if _rc == 0 rename yq full_yq

. foreach v in year quarter {
  2.     capture confirm numeric variable `v'
  3.     if _rc destring `v', replace force
  4. }

. egen yq = group(year quarter)

. gen int yq_date = yq(year, quarter)

. format yq_date %tq

. * yq in unwinding.dta and in the individual-level merges is egen group(year quarter) with 2021Q1 = 1
. assert yq == yq_date - tq(2021q1) + 1

. isid _state yq

. foreach v in post enroll_adult rx_ob_1k_adult spend_ob_adult rx_nonob_1k_adult spend_nonob_adult {
  2.     confirm variable `v'
  3. }

. 
. *---- 2. unwinding and enrollment (same construction as the repo) ---------------
. merge 1:1 _state yq using "$prep/b-data/unwinding.dta", generate(_mu)
(variable yq_date was int, now float to accommodate using data's values)

    Result                      Number of obs
    -----------------------------------------
    Not matched                            60
        from master                         0  (_mu==1)
        from using                         60  (_mu==2)

    Matched                               960  (_mu==3)
    -----------------------------------------

. tab _mu

   Matching result from |
                  merge |      Freq.     Percent        Cum.
------------------------+-----------------------------------
         Using only (2) |         60        5.88        5.88
            Matched (3) |        960       94.12      100.00
------------------------+-----------------------------------
                  Total |      1,020      100.00

. drop if _mu == 2
(60 observations deleted)

. drop _mu

. confirm variable value

. replace value = 0 if missing(value)
(720 real changes made)

. gen ln_unwind = log(value + 1)

. gen ln_enroll = log(enroll_adult)

. label var ln_unwind "log(unwinding disenrollments + 1)"

. label var ln_enroll "log adult Medicaid enrollment, same quarter"

. 
. *---- 3. policy variables ----------------------------------------------------------
. foreach v of global newvars {
  2.     confirm new variable `v'
  3. }

. merge 1:1 _state yq_date using "$ctrl/controls_state_yq.dta", keepusing($newvars) keep(master match) generate(_mc)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                               960  (_mc==3)
    -----------------------------------------

. tab _mc

   Matching result from |
                  merge |      Freq.     Percent        Cum.
------------------------+-----------------------------------
            Matched (3) |        960      100.00      100.00
------------------------+-----------------------------------
                  Total |        960      100.00

. * 3 = matched. 1 = a state-quarter outside the controls panel (2021Q1-2025Q4, 50 states + DC); its policy variables are missing.
. drop _mc

. 
. count
  960

. sort _state yq

. save "$ctrl/state_controls_yq.dta", replace
file C:/Users/jsemprini/OneDrive - Des Moines University/9-Internal-Collab/a-Devine_GLP1/1-stata/controls/state_controls_yq.dta saved

. 
. *---- 4. collinearity of the full control set in the estimation samples -------------
. * main = 2021Q1-2024Q4 ; ext = through 2025Q4 without CA, NV, MS (no 2025 BRFSS interviews in CA and NV)
. foreach run in main ext {
  2.     preserve
  3.     drop if inlist(_state, 1, 12, 13, 20, 28, 37, 45, 46, 47, 48) | inlist(_state, 55, 56)
  4.     if "`run'" == "main" drop if yq_date > tq(2024q4)
  5.     if "`run'" == "ext" drop if inlist(_state, 6, 32, 28)
  6.     egen byte _nm = rowmiss(ln_enroll ln_unwind $pol_all)
  7.     di _n as text "======== `run' sample: state-quarters with every control observed ========"
  8.     tab _nm
  9.     keep if _nm == 0
 10.     egen byte _tag = tag(_state)
 11.     quietly count if _tag
 12.     di as text "states in the complete-case sample: " r(N)
 13.     quietly count
 14.     di as text "state-quarter cells: " r(N)
 15.     di as text "States lost to missing controls: DC (no NCSL data) and Nebraska (no partisan legislature)."
 16.     vif_resid ln_enroll ln_unwind $pol_all
 17.     restore
 18. }
